# ═══════════════════════════════════════════════════════════════════════════
#  Copy this file to `.env.local` and fill in the values.
#  Full step-by-step instructions are in SETUP-GUIDE.pdf.
# ═══════════════════════════════════════════════════════════════════════════

# ── 1. YOUR WEBSITE ────────────────────────────────────────────────────────
# Your live domain, no trailing slash. Use http://localhost:3000 while testing.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ── 2. SUPABASE (database + admin login) ───────────────────────────────────
# Supabase Dashboard → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=
#
# Supabase now issues two possible key formats depending on when your project
# was created. Use WHICHEVER PAIR your dashboard shows you — only one pair is
# needed, not both:
#
#   Older projects  → Project Settings → API → "anon" and "service_role"
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
#   Newer projects   → Project Settings → API Keys → "publishable" and "secret"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
#
# The two SECRET ones (service_role / secret) bypass every permission check.
# Never prefix them with NEXT_PUBLIC_ and never commit this file.


# ── 3. CLOUDFLARE R2 (PDF + image storage) — OPTIONAL ──────────────────────
# LEAVE THIS WHOLE SECTION BLANK TO LAUNCH WITHOUT R2.
#
# With these blank, every upload goes to Supabase Storage instead and the site
# is fully functional — publishing editions, banner artwork and downloads all
# work. The only difference is the free Supabase plan's ~5 GB of downloads a
# month; R2 has no download charge at all, so move to it once traffic grows.
# Nothing needs re-uploading when you switch: new files simply go to the new
# home and the old URLs keep working.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=vaaram-media
# The public URL of your bucket, no trailing slash.
# e.g. https://media.yourdomain.com  or  https://pub-xxxxxxxx.r2.dev
NEXT_PUBLIC_R2_PUBLIC_URL=


# ── 4. EMAIL NOTIFICATIONS (optional) ──────────────────────────────────────
# Free key from https://resend.com (Free plan: 3,000 emails/month, 100/day) —
# enquiries are ALWAYS saved to your admin dashboard; this just also emails
# you a copy. Leave blank to skip.
RESEND_API_KEY=
#
# Who the notification appears to come from. Works out of the box with
# Resend's shared test address below. Once your domain is verified in Resend
# (Dashboard → Domains → Add Domain → add the DNS records it shows you),
# switch this to an address on your own domain instead, e.g.
# "Vaaram Magazine <notifications@vaaram.ca>".
RESEND_FROM_EMAIL=Vaaram Magazine <onboarding@resend.dev>


# ── 5. KEEPING THE DATABASE AWAKE (optional) ───────────────────────────────
# Supabase pauses a free project after 7 days with no database activity, which
# takes the whole website down. Two independent things prevent that: a GitHub
# Actions workflow (.github/workflows/keep-alive.yml, daily at 06:00 UTC) and a
# Vercel Cron Job (vercel.json, daily at 18:00 UTC).
#
# Set CRON_SECRET on the Vercel project and Vercel will send it as
# "Authorization: Bearer <value>" on every cron invocation, and
# /api/cron/keep-alive will refuse anything else. Any long random string will
# do. Leave it blank and the route still works — it is rate limited instead.
CRON_SECRET=


# ── 6. AFTER FILLING THIS IN ───────────────────────────────────────────────
# Open the Supabase SQL Editor, paste the whole of supabase/schema.sql and
# press RUN. It creates the publications, ad_banners, enquiries and
# subscribers tables and is safe to run more than once. Admin → Settings will
# tell you if any table is still missing.
