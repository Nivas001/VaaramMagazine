# ═══════════════════════════════════════════════════════════════════════════
#  Copy this file to `.env.local` and fill in the values.
#  Full step-by-step instructions are in SETUP-GUIDE.pdf.
# ═══════════════════════════════════════════════════════════════════════════

# ── 1. YOUR WEBSITE ────────────────────────────────────────────────────────
# Your live domain, no trailing slash. Use http://localhost:3000 while testing.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ── 2. SUPABASE (database + admin login) ───────────────────────────────────
# Supabase Dashboard → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=
#
# Supabase now issues two possible key formats depending on when your project
# was created. Use WHICHEVER PAIR your dashboard shows you — only one pair is
# needed, not both:
#
#   Older projects  → Project Settings → API → "anon" and "service_role"
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
#   Newer projects   → Project Settings → API Keys → "publishable" and "secret"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
#
# The two SECRET ones (service_role / secret) bypass every permission check.
# Never prefix them with NEXT_PUBLIC_ and never commit this file.


# ── 3. CLOUDFLARE R2 (PDF + image storage, zero bandwidth cost) ────────────
# Recommended. If you leave these blank the site automatically falls back to
# Supabase Storage, which works but has a 5 GB/month download limit.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=adexpress-media
# The public URL of your bucket, no trailing slash.
# e.g. https://media.yourdomain.com  or  https://pub-xxxxxxxx.r2.dev
NEXT_PUBLIC_R2_PUBLIC_URL=


# ── 4. EMAIL NOTIFICATIONS (optional) ──────────────────────────────────────
# Free key from https://web3forms.com — enquiries are ALWAYS saved to your
# admin dashboard; this just also emails you a copy. Leave blank to skip.
WEB3FORMS_ACCESS_KEY=
